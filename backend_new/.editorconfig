root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# EF Core migrations are generated (with a BOM); dotnet format leaves them alone
[**/Migrations/*.cs]
generated_code = true
charset = unset

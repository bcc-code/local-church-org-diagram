<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Backend</RootNamespace>
    <UserSecretsId>6650a9f0-718e-4c49-b843-f8b95afc7055</UserSecretsId>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../openapi</OpenApiDocumentsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Npgsql" Version="13.6.5" />
    <PackageReference Include="BccCode.Core.Api.Client" Version="0.0.2007" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.65.1" />
    <PackageReference Include="WolverineFx.Http.FluentValidation" Version="6.65.1" />
    <PackageReference Include="WolverineFx.Http.Marten" Version="6.65.1" />
    <PackageReference Include="WolverineFx.Marten" Version="6.65.1" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" Version="6.65.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\servicedefaults\servicedefaults.csproj" />
  </ItemGroup>

</Project>
